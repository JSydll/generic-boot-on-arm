#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
readonly SCRIPT_DIR

readonly TEST_ARTIFACTS_DIR="${TEST_ARTIFACTS_DIR:-${SCRIPT_DIR}/work/artifacts}"

readonly KAS_CMD="${SCRIPT_DIR}/tools/build/kas-container.5.1"
export KAS_WORK_DIR="${SCRIPT_DIR}/work"
readonly KAS_CONF_BASE="${SCRIPT_DIR}/conf"

readonly VIRT_MACHINE="virt-aarch64"
readonly HW_MACHINE="verdin-imx8mp"

# Defaults
# ----
TARGET_MACHINE="${TARGET_MACHINE:-${HW_MACHINE}}"
BUILD_TYPE="debug"
TEST_DOCKER_IMAGE="emulated-linux-testing"
# By default, expect signed images to be built.
export RECOVERY_FASTBOOT_DEV_ID="1b67:4040"
# ----

# Setup
# ----
function testenv_setup() {
    local -r flag="$1"
    if [[ "${flag}" == "-f" ]] || ! docker inspect "${TEST_DOCKER_IMAGE}" &>/dev/null; then
        DOCKER_BUILDKIT=1 docker build -t "${TEST_DOCKER_IMAGE}" "${SCRIPT_DIR}/tools/test"
    fi
}

function set_machine() {
    export TARGET_MACHINE="$1" 
}

function set_build_conf() {
    export BUILD_CONF="$1"
}

function get_build_conf() {
    if [[ -n "${BUILD_CONF}" ]]; then
        echo "${BUILD_CONF}"
    else
        echo "${KAS_CONF_BASE}/includes/${BUILD_TYPE}.yml:${KAS_CONF_BASE}/${TARGET_MACHINE}.yml"
    fi    
}

alias enable-signed='export RECOVERY_FASTBOOT_DEV_ID="1b67:4040"'
alias enable-unsigned='export RECOVERY_FASTBOOT_DEV_ID="1b67:4000"'
alias set-machine='set_machine'
alias set-build-conf='set_build_conf'
alias buildenv-setup='${KAS_CMD} checkout $(get_build_conf)'
alias testenv-rebuild='testenv_setup -f'
# ----

# Build
# ----
alias build-dump='${KAS_CMD} dump $(get_build_conf)'
alias build-shell='${KAS_CMD} shell $(get_build_conf)'
alias build-current='${KAS_CMD} build $(get_build_conf)'
alias build-runqemu='${KAS_CMD} shell $(get_build_conf) -c "runqemu secure-image-minimal wic.qcow2 serial nographic slirp qemuparams=\" -snapshot\""'

function build_configuration() {
    if [[ "${TARGET_MACHINE}" != "${HW_MACHINE}" ]]; then
        echo "Error: build_configuration can only be used with TARGET_MACHINE=${HW_MACHINE}" >&2
        return 1
    fi

    local -r base_conf="${KAS_CONF_BASE}/includes/base.yml:${KAS_CONF_BASE}/verdin-imx8mp.yml"
    local -r config="$1"

    if [[ -z "${config}" ]] || [[ ! "${config}" =~ ^(recovery|provisioning|production)$ ]]; then
        echo "Usage: $0 <config>"
        echo "Example: $0 [recovery|provisioning|production]"
        exit 2
    fi

    if [[ "${config}" == "recovery" ]]; then
        set_build_conf "${base_conf}:${KAS_CONF_BASE}/includes/verdin-imx8mp/recovery.yml"
    elif [[ "${config}" == "provisioning" ]]; then
        set_build_conf "${base_conf}:${KAS_CONF_BASE}/includes/verdin-imx8mp/recovery.yml:${KAS_CONF_BASE}/includes/verdin-imx8mp/provisioning.yml"
    else
        set_build_conf "${base_conf}"
    fi

    echo "Building $(get_build_conf)..."
    build-current
}
alias build-config='build_configuration'

function publish_test_artifacts() {
    mkdir -p "${TEST_ARTIFACTS_DIR}"

    for machine in ${VIRT_MACHINE} ${HW_MACHINE}; do
        local src_path="${SCRIPT_DIR}/work/build/tmp/deploy/images/${machine}"
        cp "${src_path}/flash.bin" "${TEST_ARTIFACTS_DIR}/flash.bin" &>/dev/null || true
        cp "${src_path}/secure-image-minimal-${VIRT_MACHINE}.rootfs.wic.qcow2" "${TEST_ARTIFACTS_DIR}/system-image.wic.qcow2" &>/dev/null || true
        cp "${src_path}/secure-update-bundle-${machine}.raucb" "${TEST_ARTIFACTS_DIR}/secure-update-bundle-${machine}.raucb" &>/dev/null || true
        cp "${src_path}/lg-env-config-${machine}.yml" "${TEST_ARTIFACTS_DIR}/lg-env-config-${machine}.yml" &>/dev/null || true         
    done
}

alias build-publish='publish_test_artifacts'
# ----

# Test
# ----
function run_in_testenv() {
    # Make sure the test environment is available
    testenv_setup

    local extra_opts=""
    if [[ "$1" == "-i" ]]; then
        extra_opts+="-i "
        shift
    fi
    # For some unknown reason, pytest is not able to locate the pytest.ini
    # without explicitly specifying it in non-interactive runs.
    PYTEST_OPTIONS="-c /test/pytest.ini --lg-env /artifacts/lg-env-config-${TARGET_MACHINE}.yml"
    # Spawn an ephemeral test container and pass command parameters to it
    docker run --rm -t \
        -v "${SCRIPT_DIR}/test"/:/test/ \
        -v "${TEST_ARTIFACTS_DIR}"/:/artifacts:ro \
        -w /test ${extra_opts} \
        -e PYTEST_ADDOPTS="${PYTEST_OPTIONS}" \
        ${TEST_DOCKER_IMAGE} "$@"
}

alias test-shell='run_in_testenv -i /bin/bash'
alias test-run-pytest='run_in_testenv /usr/local/bin/pytest'
# ----

# Flash
# ----
function flash_device() {
    if [[ "${TARGET_MACHINE}" != "${HW_MACHINE}" ]]; then
        echo "Error: flash_device can only be used with TARGET_MACHINE=${HW_MACHINE}" >&2
        return 1
    fi

    local artifact_path="${SCRIPT_DIR}/work/build/tmp/deploy/images/${HW_MACHINE}"
    "${SCRIPT_DIR}/tools/flash/flash.sh" "${artifact_path}" "flash.bin" "secure-image-minimal-${HW_MACHINE}.rootfs.wic"
}
alias flash-device='flash_device'
